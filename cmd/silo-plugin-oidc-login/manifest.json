{
  "plugin_id": "silo.oidc-login",
  "version": "1.0.4",
  "checksum": "__CHECKSUM__",
  "silo_api_version": "v1",
  "category": "Auth",
  "supported_platforms": [
    {
      "os": "linux",
      "arch": "amd64"
    }
  ],
  "capabilities": [
    {
      "type": "auth_provider.v1",
      "id": "oidc",
      "display_name": "Sign in with OIDC",
      "description": "Generic OIDC authentication. Multi-instance: install once per IdP.",
      "auth_modes": [
        "oauth2"
      ],
      "icon_url": "/assets/generic-key.svg"
    },
    {
      "type": "http_routes.v1",
      "id": "spa",
      "display_name": "OIDC admin SPA",
      "description": "Visual editors for claim filters and role mapping."
    }
  ],
  "http_routes": [
    {
      "id": "assets",
      "method": "GET",
      "path": "/assets/*",
      "access": "public"
    },
    {
      "id": "admin_html",
      "method": "GET",
      "path": "/admin",
      "access": "admin",
      "navigable": true,
      "navigation_label": "OIDC Login",
      "navigation_kind": "admin"
    },
    {
      "id": "admin_html_sub",
      "method": "GET",
      "path": "/admin/*",
      "access": "admin"
    },
    {
      "id": "admin_api",
      "method": "*",
      "path": "/api/v1/admin/*",
      "access": "admin"
    },
    {
      "id": "health",
      "method": "GET",
      "path": "/api/v1/health",
      "access": "public"
    }
  ],
  "global_config_schema": [
    {
      "key": "database_url",
      "title": "Postgres connection string",
      "description": "DSN for the dedicated oidc_login schema (e.g. postgres://plugin_oidc_login:...@host:5432/silo?search_path=oidc_login&sslmode=disable).",
      "json_schema": "{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"string\"}},\"required\":[\"value\"]}",
      "required": true,
      "admin_form": {
        "fields": [
          {
            "key": "value",
            "label": "Connection URL",
            "control": "ADMIN_FORM_CONTROL_PASSWORD",
            "required": true,
            "secret": true
          }
        ]
      }
    }
  ]
}